{
  "$comment": "Single source of truth for x-ui tokens. Colours are the 2026-10-04 black-and-white set and are identical on every brand. Brands differ in type, wordmark, heading case and radius.",
  "base": {
    "selector": ":root",
    "declarations": [
      ["--xui-color-text-on-image", "#FFFFFF"],
      ["--xui-font-cjk", "\"Noto Sans SC\",\"Noto Sans CJK SC\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif"],
      ["--xui-type-display-xl", "clamp(52px,7.2vw,112px)"],
      ["--xui-type-display-lg", "clamp(40px,5vw,76px)"],
      ["--xui-type-heading-lg", "clamp(30px,3.2vw,48px)"],
      ["--xui-type-heading-md", "clamp(24px,2.2vw,32px)"],
      ["--xui-type-body-lg", "clamp(18px,1.4vw,21px)"],
      ["--xui-type-body-md", "17px"],
      ["--xui-type-body-sm", "15px"],
      ["--xui-type-label", "13px"],
      ["--xui-type-line-height-display", "1.05"],
      ["--xui-type-line-height-heading", "1.15"],
      ["--xui-type-line-height-body", "1.55"],
      ["--xui-type-tracking-label", ".06em"],
      ["--xui-type-tracking-heading", ".01em"],
      ["--xui-type-tracking-body", "0"],
      ["--xui-type-button", "var(--xui-type-body-sm)"],
      ["--xui-type-nav", "var(--xui-type-body-sm)"],
      ["--xui-type-wordmark", "var(--xui-type-body-lg)"],
      ["--xui-type-menu-row", "var(--xui-type-heading-lg)"],
      ["--xui-type-footer", "var(--xui-type-body-sm)"],
      ["--xui-type-pill", "var(--xui-type-label)"],
      ["--xui-type-release", "var(--xui-type-body-sm)"],
      ["--xui-space-1", "4px"],
      ["--xui-space-2", "8px"],
      ["--xui-space-3", "12px"],
      ["--xui-space-4", "16px"],
      ["--xui-space-5", "24px"],
      ["--xui-space-6", "32px"],
      ["--xui-space-7", "48px"],
      ["--xui-space-8", "64px"],
      ["--xui-space-9", "96px"],
      ["--xui-space-10", "128px"],
      ["--xui-space-11", "160px"],
      ["--xui-radius-none", "0"],
      ["--xui-radius-sm", "2px"],
      ["--xui-radius-md", "4px"],
      ["--xui-radius-pill", "999px"],
      ["--xui-motion-duration-fast", "150ms"],
      ["--xui-motion-duration-base", "250ms"],
      ["--xui-motion-duration-slow", "600ms"],
      ["--xui-motion-easing-standard", "cubic-bezier(.2,0,0,1)"],
      ["--xui-layout-max", "1280px"],
      ["--xui-layout-margin", "64px"],
      ["--xui-layout-gutter", "24px"],
      ["--xui-layout-nav-height", "64px"],
      ["--xui-size-control-min", "44px"],
      ["--xui-size-button", "48px"],
      ["--xui-size-menu-row", "64px"],
      ["--xui-focus-width", "2px"],
      ["--xui-border-width-subtle", "1px"],
      ["--xui-border-width-strong", "1px"],
      ["--xui-border-width-accent", "2px"],
      ["--xui-border-width-emphasis", "3px"],
      ["--xui-focus-offset", "3px"],
      ["--xui-safe-top", "env(safe-area-inset-top,0px)"],
      ["--xui-safe-right", "env(safe-area-inset-right,0px)"],
      ["--xui-safe-bottom", "env(safe-area-inset-bottom,0px)"],
      ["--xui-safe-left", "env(safe-area-inset-left,0px)"]
    ]
  },
  "scopes": [
    {
      "selector": ":root:lang(zh)",
      "declarations": [
        ["--xui-font-display", "var(--xui-font-cjk)"],
        ["--xui-type-case-heading", "none"],
        ["--xui-type-tracking-label", "0"],
        ["--xui-type-tracking-heading", "0"],
        ["--xui-type-line-height-display", "1.2"],
        ["--xui-type-line-height-heading", "1.3"],
        ["--xui-type-line-height-body", "1.75"]
      ]
    },
    {
      "media": "(max-width:1023px)",
      "selector": ":root",
      "declarations": [
        ["--xui-layout-margin", "32px"]
      ]
    },
    {
      "media": "(max-width:767px)",
      "selector": ":root",
      "declarations": [
        ["--xui-layout-margin", "20px"],
        ["--xui-layout-nav-height", "56px"]
      ]
    },
    {
      "media": "(max-width:479px)",
      "selector": ":root",
      "declarations": [
        ["--xui-type-body-md", "16px"]
      ]
    },
    {
      "media": "(prefers-reduced-motion:reduce)",
      "selector": ":root",
      "declarations": [
        ["--xui-motion-duration-fast", "0ms"],
        ["--xui-motion-duration-base", "0ms"],
        ["--xui-motion-duration-slow", "0ms"]
      ]
    }
  ],
  "color": {
    "dark": [
      ["--xui-color-bg-base", "#000000"],
      ["--xui-color-bg-raised", "#000000"],
      ["--xui-color-bg-inverse", "#FFFFFF"],
      ["--xui-color-text-primary", "#FFFFFF"],
      ["--xui-color-text-secondary", "#B3B3B3"],
      ["--xui-color-text-tertiary", "#8F8F8F"],
      ["--xui-color-text-inverse", "#000000"],
      ["--xui-color-border-subtle", "#5E5E5E"],
      ["--xui-color-border-strong", "#767676"],
      ["--xui-color-accent-text", "#FFFFFF"],
      ["--xui-color-accent-fill", "#FFFFFF"],
      ["--xui-color-accent-on", "#000000"],
      ["--xui-color-action-fill", "#FFFFFF"],
      ["--xui-color-action-on", "#000000"],
      ["--xui-color-highlight", "transparent"],
      ["--xui-color-avatar-ring", "#5E5E5E"],
      ["--xui-color-avatar-halo", "transparent"],
      ["--xui-color-accent-strong", "var(--xui-color-accent-text)"],
      ["--xui-color-focus-ring", "var(--xui-color-text-primary)"]
    ],
    "light": [
      ["--xui-color-bg-base", "#FFFFFF"],
      ["--xui-color-bg-raised", "#FFFFFF"],
      ["--xui-color-bg-inverse", "#000000"],
      ["--xui-color-text-primary", "#000000"],
      ["--xui-color-text-secondary", "#525252"],
      ["--xui-color-text-tertiary", "#6B6B6B"],
      ["--xui-color-text-inverse", "#FFFFFF"],
      ["--xui-color-border-subtle", "#8F8F8F"],
      ["--xui-color-border-strong", "#767676"],
      ["--xui-color-accent-text", "#000000"],
      ["--xui-color-accent-fill", "#000000"],
      ["--xui-color-accent-on", "#FFFFFF"],
      ["--xui-color-action-fill", "#000000"],
      ["--xui-color-action-on", "#FFFFFF"],
      ["--xui-color-highlight", "transparent"],
      ["--xui-color-avatar-ring", "#8F8F8F"],
      ["--xui-color-avatar-halo", "transparent"],
      ["--xui-color-accent-strong", "var(--xui-color-accent-text)"],
      ["--xui-color-focus-ring", "var(--xui-color-text-primary)"]
    ]
  },
  "brands": {
    "zane": {
      "selector": "[data-brand=\"zane\"]",
      "shape": [
        ["--xui-font-display", "\"Barlow Condensed\",var(--xui-font-cjk)"],
        ["--xui-font-body", "\"Inter\",system-ui,var(--xui-font-cjk)"],
        ["--xui-font-mono", "\"JetBrains Mono\",ui-monospace,monospace"],
        ["--xui-font-wordmark", "\"Barlow Condensed\",sans-serif"],
        ["--xui-type-case-heading", "uppercase"],
        ["--xui-radius-component", "2px"],
        ["--xui-shadow-overlay", "none"]
      ]
    },
    "opcorbit": {
      "selector": "[data-brand=\"opcorbit\"]",
      "shape": [
        ["--xui-font-display", "\"Geist\",var(--xui-font-cjk)"],
        ["--xui-font-body", "\"Geist\",system-ui,var(--xui-font-cjk)"],
        ["--xui-font-mono", "\"Geist Mono\",ui-monospace,monospace"],
        ["--xui-font-wordmark", "\"Geist\",sans-serif"],
        ["--xui-type-case-heading", "none"],
        ["--xui-radius-component", "4px"],
        ["--xui-shadow-overlay", "none"]
      ]
    }
  }
}
